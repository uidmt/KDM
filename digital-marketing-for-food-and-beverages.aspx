        }
      },
      {
        "@type": "Question",
        "name": "How does WhatsApp automated replenishment marketing work for food brands?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Based on average product consumption cycles (e.g., 21 days for a 1kg coffee pouch or snack box), automated WhatsApp messages prompt customers with 1-click re-order links, personalized flavor recommendations, and loyalty discounts."
        }
      },
      {
        "@type": "Question",
        "name": "What is the expected Return on Ad Spend (ROAS) for F&B digital marketing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our Meta and Google Shopping campaigns achieve 4.5x to 7.5x initial ROAS on D2C purchases, while repeat automated WhatsApp re-orders and B2B wholesale distributor retainers compound total returns beyond 12x ROI."
        }
      },
      {
        "@type": "Question",
        "name": "How do short aesthetic food reels on Instagram drive viral sales?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "High-sensory video reels showcasing macro ingredient sizzles, packaging unboxing crunches, and appetizing recipe creations trigger immediate cravings and impulse purchases from foodies."
        }
