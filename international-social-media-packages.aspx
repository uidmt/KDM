    <!-- ===== FAQPAGE JSON-LD STRUCTURED DATA SCHEMA ===== -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is included in your International Social Media Package?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our International Social Media packages include custom graphic & video Reel creation across Instagram, Facebook, LinkedIn, YouTube, and X (Twitter), hashtag research, profile setup & optimization, audience engagement, paid ad setup, and monthly performance reports."
          }
        },
        {
          "@type": "Question",
          "name": "Which social platforms are covered in global SMM plans?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manage Meta (Instagram & Facebook), LinkedIn, YouTube, Pinterest, X (Twitter), and TikTok depending on your target regional audience across USA, UK, UAE, Canada, and Australia."
          }
        },
        {
          "@type": "Question",
          "name": "Are high-converting Instagram Reels and Shorts included?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Our plans feature high-converting video Reels, YouTube Shorts, and creative graphic carousels engineered for viral social engagement and brand building."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide custom plans for global enterprise brands?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. In addition to our standard USD plans ($550 to $3,000/Month), we design custom enterprise social media solutions for multi-language brands and international franchises."
          }
        },
        {
          "@type": "Question",
          "name": "How do you handle social media ad campaigns globally?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We configure Meta Business Manager, LinkedIn Campaign Manager, and YouTube Video Ads with server-side event tracking (CAPI) to drive qualified global leads and sales."
          }
        },
        {
          "@type": "Question",
          "name": "Who creates content for my social media accounts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All post graphics, captions, hashtags, and video Reels are crafted by our dedicated in-house designers and copywriters supervised directly by Founder Gaurav Dubey."
          }
        },
        {
          "@type": "Question",
          "name": "Why choose King of Digital Marketing for International SMM?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We bring 13+ years of experience delivering over 900+ successful campaigns across 15+ countries, backed by transparent monthly KPI reports and creative excellence."
          }
        }
      ]
    }
    </script>
</asp:Content>

