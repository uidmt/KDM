          content: "";
          position: absolute;
          background: linear-gradient(90deg, transparent, #ffd86b, transparent);
          transition: 0.4s;
          opacity: 0;
        }

        /* Top line */
        .text-box::before {
          top: 0;
          left: -100%;
          width: 100%;
          height: 2px;
        }

        /* Bottom line */
        .text-box::after {
          bottom: 0;
          right: -100%;
          width: 100%;
          height: 2px;
