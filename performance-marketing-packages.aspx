        },
        {
          "@type": "Question",
          "name": "Who manages my ad accounts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your account is managed by senior Google & Meta certified ad buyers, copywriters, and designers supervised directly by Founder Gaurav Dubey."
