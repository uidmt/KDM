		<!-- Get Started Section Ends -->
		<script>
			var kdmCurrentPage = 1;
			var kdmCardsPerPage = 12;

			function kdmInitPagination() {
				var cards = document.querySelectorAll('#blog-grid .blog-card');
				if (!cards.length) return;

				var totalPages = Math.ceil(cards.length / kdmCardsPerPage);
				kdmShowPage(1);
				kdmRenderPaginationControls(totalPages);
			}

			function kdmShowPage(page) {
				kdmCurrentPage = page;
				var cards = document.querySelectorAll('#blog-grid .blog-card');
				var start = (page - 1) * kdmCardsPerPage;
				var end = start + kdmCardsPerPage;

				cards.forEach(function (card, idx) {
					if (idx >= start && idx < end) {
						card.style.display = 'flex';
					} else {
						card.style.display = 'none';
					}
				});

				var grid = document.getElementById('blog-grid');
				if (grid && page > 1) {
					grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}
			}

			function kdmRenderPaginationControls(totalPages) {
				var wrap = document.getElementById('kdmBlogPagination');
				if (!wrap) {
					wrap = document.createElement('div');
					wrap.id = 'kdmBlogPagination';
					wrap.className = 'kdm-pagination-wrap';
					var grid = document.getElementById('blog-grid');
					if (grid && grid.parentNode) {
						grid.parentNode.appendChild(wrap);
					}
				}

				var html = '<div class="kdm-pagination">';
				if (kdmCurrentPage > 1) {
					html += '<button onclick="kdmShowPage(' + (kdmCurrentPage - 1) + '); kdmRenderPaginationControls(' + totalPages + ');" class="page-btn prev-btn"><i class="fa fa-angle-left"></i> Prev</button>';
				}

				var startPage = Math.max(1, kdmCurrentPage - 2);
				var endPage = Math.min(totalPages, startPage + 4);

				for (var i = startPage; i <= endPage; i++) {
					var activeClass = (i === kdmCurrentPage) ? ' active' : '';
					html += '<button onclick="kdmShowPage(' + i + '); kdmRenderPaginationControls(' + totalPages + ');" class="page-btn' + activeClass + '">' + i + '</button>';
				}

				if (kdmCurrentPage < totalPages) {
					html += '<button onclick="kdmShowPage(' + (kdmCurrentPage + 1) + '); kdmRenderPaginationControls(' + totalPages + ');" class="page-btn next-btn">Next <i class="fa fa-angle-right"></i></button>';
				}
				html += '</div>';

				wrap.innerHTML = html;
			}

			function kdmFilterBlogCards() {
				var input = document.getElementById('kdmBlogHeroSearch');
				if (!input) return;
				var filter = input.value.toLowerCase();
				var cards = document.querySelectorAll('.blog-card');

				cards.forEach(function (card) {
					var text = card.innerText.toLowerCase();
					if (text.indexOf(filter) > -1) {
						card.style.display = 'flex';
					} else {
						card.style.display = 'none';
					}
				});
			}

			function kdmSetTopicFilter(topic, elem) {
				document.querySelectorAll('.topic-chip').forEach(function (c) {
					c.classList.remove('active');
				});
				if (elem) elem.classList.add('active');

				var cards = document.querySelectorAll('.blog-card');
				if (topic === 'all') {
					cards.forEach(function (c) { c.style.display = 'flex'; });
					return;
				}

				var filter = topic.toLowerCase();
				cards.forEach(function (card) {
					var text = card.innerText.toLowerCase();
					if (text.indexOf(filter) > -1) {
						card.style.display = 'flex';
					} else {
						card.style.display = 'none';
					}
				});
			}

			document.addEventListener('DOMContentLoaded', kdmInitPagination);
			if (document.readyState === 'interactive' || document.readyState === 'complete') {
				kdmInitPagination();
			}
		</script>
