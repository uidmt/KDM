					<script>
						(function() {
							const seoSection = document.querySelector('.seo-results');
							if (!seoSection) return;
							const slides = seoSection.querySelector('.slides');
							const prevBtn = seoSection.querySelector('.nav-btn.prev');
							const nextBtn = seoSection.querySelector('.nav-btn.next');
							let index = 0;

							function showSlide() {
								const card = seoSection.querySelector('.seo-card');
								if (!card || !slides) return;
								const slideWidth = card.clientWidth;
								slides.style.transform = `translateX(${-index * slideWidth}px)`;
							}

							if (nextBtn) {
								nextBtn.addEventListener('click', function(e) {
									e.preventDefault();
									if (window.innerWidth < 768) {
										if (index < 6) index++;
										showSlide();
									} else {
										if (index < 5) index++;
										showSlide();
									}
								});
							}

							if (prevBtn) {
								prevBtn.addEventListener('click', function(e) {
									e.preventDefault();
									if (index > 0) index--;
									showSlide();
								});
							}

							window.addEventListener('resize', showSlide);
						})();
					</script>
