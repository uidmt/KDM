          "@type": "Question",
          "name": "How do you decide the right strategy for my business?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We start with a detailed audit of your website, competitors, target audience, and current offers to build a customized growth strategy tailored specifically to your industry."
          }
        },
        {
          "@type": "Question",
          "name": "Will I get regular reports and updates?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. You receive transparent monthly reports covering website traffic, keyword rankings, lead conversions, ad spend performance, and strategic improvement plans."
          }
        },
        {
          "@type": "Question",
          "name": "Who will manage my account and campaigns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your account is managed by experienced digital marketing specialists across SEO, PPC, content, and social media under the leadership of Founder Gaurav Dubey."
          }
        },
        {
          "@type": "Question",
          "name": "Why should I choose your package over other agencies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We follow an audit-first, transparent, and result-focused digital marketing approach backed by 13+ years of proven expertise, 900+ projects, and all services managed under one roof."
          }
        }
      ]
    }
