    <!-- ===== FAQPAGE JSON-LD STRUCTURED DATA SCHEMA ===== -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is included in your App Promotion Packages?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our App Promotion packages cover Google Play Store & Apple App Store ASO keyword optimization, Google Universal App Campaigns (UAC), Meta & Instagram App Install Ads, Apple Search Ads, App Icon & Screenshot CRO design, Rating/Review management, AppsFlyer/Adjust attribution setup, and weekly CPI performance reporting."
          }
        },
        {
          "@type": "Question",
          "name": "What is App Store Optimization (ASO)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ASO is the process of optimizing mobile app titles, subtitles, keyword tags, descriptions, icons, and screenshots to rank higher in organic search results on Google Play Store and Apple App Store."
          }
        },
        {
          "@type": "Question",
          "name": "Is advertising ad spend included in the package pricing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Package pricing covers complete ASO optimization, ad creative design, copywriting, attribution SDK integration, campaign setup, and CPI bidding management. Ad spend is paid directly to Google UAC, Meta, or Apple Search Ads."
          }
        },
        {
          "@type": "Question",
          "name": "Which mobile platforms do you promote?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We promote both Android apps on Google Play Store and iOS apps on Apple App Store."
          }
        },
        {
          "@type": "Question",
          "name": "How quickly do app install campaigns start working?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paid app install campaigns (Google UAC & Meta Ads) deliver immediate installs on Day 1, while organic ASO keyword rankings climb significantly over 30 to 60 days."
          }
        },
        {
          "@type": "Question",
          "name": "Who manages my app promotion campaign?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your campaigns are managed by certified Mobile App Marketing Leads and ASO Specialists supervised directly by Founder Gaurav Dubey."
          }
        },
        {
          "@type": "Question",
          "name": "Why choose King of Digital Marketing for Mobile App Promotion?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We bring 13+ years of experience delivering over 900+ mobile growth campaigns, backed by transparent INR pricing, low Cost-Per-Install (CPI) bidding, and organic ASO rank domination."
          }
        }
      ]
    }
    </script>
