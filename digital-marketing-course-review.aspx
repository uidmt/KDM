<style>
			.review-page-wrapper {
				padding: 0 0 70px 0;
				background: #f8fafc;
			}

			.review-hero-fullwidth {
				width: 100vw;
				position: relative;
				left: 50%;
				right: 50%;
				margin-left: -50vw;
				margin-right: -50vw;
				background: linear-gradient(135deg, #0f172a 0%, #0f2744 45%, #0284c7 100%);
				color: #ffffff;
				padding: 55px 0;
				margin-bottom: 45px;
				box-shadow: 0 15px 40px rgba(15, 23, 42, 0.25);
				overflow: hidden;
			}

			.review-hero-fullwidth::before {
				content: '';
				position: absolute;
				top: -40%;
				right: -10%;
				width: 600px;
				height: 600px;
				background: radial-gradient(circle, rgba(56, 189, 248, 0.18) 0%, rgba(15, 23, 42, 0) 70%);
				pointer-events: none;
			}

			.review-hero-grid {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 35px;
			}

			.review-hero-copy {
				flex: 1 1 60%;
			}

			.review-hero-form-col {
				flex: 0 0 390px;
				max-width: 100%;
			}

			.review-hero-badge {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				background: rgba(56, 189, 248, 0.15);
				color: #38bdf8;
				border: 1px solid rgba(56, 189, 248, 0.35);
				font-size: 11px;
				font-weight: 800;
				letter-spacing: 1px;
				text-transform: uppercase;
				padding: 5px 14px;
				border-radius: 20px;
				margin-bottom: 14px;
			}

			.review-hero-title {
				font-size: 36px;
				font-weight: 800;
				color: #ffffff;
				margin-bottom: 12px;
				line-height: 1.25;
				background: linear-gradient(180deg, #ffffff 0%, #bae6fd 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.review-hero-desc {
				color: #e2e8f0;
				font-size: 15px;
				line-height: 1.65;
				margin-bottom: 20px;
			}

			.review-proof-bar {
				display: flex;
				align-items: center;
				gap: 15px;
				background: rgba(255, 255, 255, 0.08);
				backdrop-filter: blur(8px);
				padding: 9px 16px;
				border-radius: 12px;
				width: fit-content;
				margin-bottom: 25px;
				border: 1px solid rgba(255, 255, 255, 0.14);
			}

			.review-cta-group {
				display: flex;
				align-items: center;
				gap: 14px;
				flex-wrap: wrap;
			}

			.review-btn-primary {
				background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
				color: #ffffff !important;
				font-weight: 800;
				font-size: 14px;
				padding: 12px 24px;
				border-radius: 10px;
				text-decoration: none !important;
				display: inline-flex;
				align-items: center;
				gap: 8px;
				box-shadow: 0 6px 18px rgba(56, 189, 248, 0.35);
				transition: all 0.3s ease;
			}

			.review-btn-primary:hover {
				background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
				transform: translateY(-2px);
				box-shadow: 0 10px 24px rgba(56, 189, 248, 0.5);
			}

			.review-btn-call {
				background: rgba(255, 255, 255, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.25);
				color: #ffffff !important;
				font-weight: 700;
				font-size: 14px;
				padding: 11px 20px;
				border-radius: 10px;
				text-decoration: none !important;
				display: inline-flex;
				align-items: center;
				gap: 8px;
				transition: all 0.3s ease;
			}

			.review-btn-call:hover {
				background: rgba(255, 255, 255, 0.2);
				transform: translateY(-2px);
			}

			.review-form-container {
				background: rgba(15, 23, 42, 0.6);
				backdrop-filter: blur(12px);
				border-radius: 20px;
				padding: 8px;
				box-shadow: 0 20px 45px rgba(0, 0, 0, 0.4), 0 0 30px rgba(56, 189, 248, 0.2);
				border: 1px solid rgba(56, 189, 248, 0.3);
			}

			@media (max-width: 992px) {
				.review-hero-grid {
					flex-direction: column;
				}

