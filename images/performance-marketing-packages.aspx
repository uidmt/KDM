}

/* ====== Text Box with Animated Border ====== */
.text-box {
  position: relative;
  padding: 30px 40px;
  text-align: center;
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s ease;
}

/* Text itself */
.text-box h3 {
  font-size: 1.8em;
  color: #ffd86b;
  font-weight: 700;
  margin-bottom: 10px;
  opacity: 0;
  transform: translateY(15px);
  transition: all 0.4s ease;
}
.text-box p {
  font-size: 1em;
  color: #e8e8e8;
  opacity: 0;
  transform: translateY(15px);
  transition: all 0.4s ease 0.1s;
}

/* On Hover - show text */
.industry-card:hover .text-box h3,
.industry-card:hover .text-box p {
  opacity: 1;
  transform: translateY(0);
}

/* ===== Animated Borders (4 sides) ===== */
.text-box::before,
.text-box::after,
.text-box span::before,
.text-box span::after {
  content: "";
  position: absolute;
  background: linear-gradient(90deg, transparent, #ffd86b, transparent);
  transition: 0.4s;
  opacity: 0;
}

/* Top line */
.text-box::before {
  top: 0;
  left: -100%;
  width: 100%;
  height: 2px;
}

/* Bottom line */
.text-box::after {
  bottom: 0;
  right: -100%;
  width: 100%;
  height: 2px;
}

/* Left and Right lines */
.text-box span::before {
  left: 0;
  top: -100%;
  height: 100%;
  width: 2px;
  background: linear-gradient(180deg, transparent, #ffd86b, transparent);
}
.text-box span::after {
  right: 0;
  bottom: -100%;
  height: 100%;
  width: 2px;
  background: linear-gradient(180deg, transparent, #ffd86b, transparent);
}

/* Hover animation trigger */
.text-box:hover::before {
  left: 0;
  opacity: 1;
  animation: moveLineH 1s linear forwards;
}
.text-box:hover::after {
  right: 0;
  opacity: 1;
  animation: moveLineH 1s linear forwards;
}
.text-box:hover span::before {
  top: 0;
  opacity: 1;
  animation: moveLineV 1s linear forwards;
}
.text-box:hover span::after {
  bottom: 0;
  opacity: 1;
  animation: moveLineV 1s linear forwards;
}

/* ===== Animations ===== */
@keyframes moveLineH {
  0% { transform: translateX(-100%); }
  50% { transform: translateX(0); }
  100% { transform: translateX(100%); }
}
@keyframes moveLineV {
  0% { transform: translateY(-100%); }
  50% { transform: translateY(0); }
  100% { transform: translateY(100%); }
}

/* ===== Card Hover Glow ===== */
.industry-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 0 30px rgba(255, 215, 0, 0.4);
}
</style>

