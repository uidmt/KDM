				box-shadow: 0 4px 15px rgba(6, 182, 212, 0.2);
			}

			.gd-about-dark-title {
				font-size: 34px;
				font-weight: 900;
				color: #ffffff;
				margin-top: 4px;
				margin-bottom: 16px;
				line-height: 1.25;
				letter-spacing: -0.5px;
