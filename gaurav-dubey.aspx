			.gd-timeline-desc {
				font-size: 13.5px;
				color: #cbd5e1;
				margin: 0;
				line-height: 1.55;
			}

			/* 6. Services Grid (12 Cards) */
			.gd-services-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 22px;
