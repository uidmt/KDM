				margin: 0 auto;
				transform: translateZ(0);
			}

			.gd-about-photo-glow {
				position: absolute;
				inset: -8px;
				background: radial-gradient(circle, rgba(6, 182, 212, 0.45) 0%, rgba(139, 92, 246, 0.35) 60%, transparent 80%);
