				opacity: 1;
				transform: scale(1.08);
			}

			.gd-logo-item img {
				max-height: 45px;
				width: auto;
			}

			/* Card Styling */
			.gd-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 14px;
				padding: 30px;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
				transition: all 0.3s ease;
			}

			.gd-card:hover {
				border-color: #0088cc;
				box-shadow: 0 12px 32px rgba(0, 88, 204, 0.12);
				transform: translateY(-5px);
			}

			.gd-title-center {
				text-align: center;
				margin-bottom: 35px;
			}

			.gd-title-center h2 {
				font-size: 30px;
				font-weight: 800;
				color: #0f172a;
				margin-bottom: 8px;
			}

			.gd-title-center p {
				font-size: 16px;
				color: #64748b;
				margin: 0;
			}

			/* 4. Why Choose Gaurav Dubey - 6 Cards */
			.gd-why-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 22px;
				margin-top: 20px;
			}

			.gd-why-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-left: 5px solid #0088cc;
				border-radius: 12px;
				padding: 24px;
