			.gd-about-badge {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				background: rgba(15, 23, 42, 0.8);
				border: 1px solid rgba(56, 189, 248, 0.4);
				color: #38bdf8;
				font-size: 13px;
				font-weight: 800;
				padding: 6px 18px;
				border-radius: 30px;
				letter-spacing: 1px;
				text-transform: uppercase;
