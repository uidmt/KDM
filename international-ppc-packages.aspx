    <!-- ===== FAQPAGE JSON-LD STRUCTURED DATA SCHEMA ===== -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is included in your International PPC Package?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our International PPC packages include Google Search Ads, Display Network Ads, Meta (Facebook & Instagram) Ads, LinkedIn Ads, YouTube Video Ads, conversion tracking, server-side CAPI tracking, A/B ad testing, landing page CRO advice, and transparent monthly performance reporting."
          }
        },
        {
          "@type": "Question",
          "name": "Which ad platforms do you manage for global campaigns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manage Google Search, Shopping & Performance Max Ads, Meta Ads Manager (Instagram & Facebook), LinkedIn Campaign Manager, Bing Ads, and YouTube Video Ads across target countries like USA, UK, UAE, Australia, and Canada."
          }
        },
        {
          "@type": "Question",
          "name": "Is the advertising ad spend included in the package cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The package fee covers complete campaign strategy, ad setup, creative design, conversion tracking, bid optimization, and management. Ad spend is paid directly to ad platforms (Google/Meta) using your account."
          }
        },
        {
          "@type": "Question",
          "name": "How quickly can we launch international PPC campaigns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Once account access, target country parameters, and ad creatives are finalized, campaigns go live within 3 to 5 business days."
          }
        },
        {
          "@type": "Question",
          "name": "How do you track international lead conversions and ROAS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We set up Google Tag Manager, GA4 eCommerce event tracking, Meta Conversions API (CAPI), and call tracking to monitor exact ROAS and cost per acquisition (CPA)."
          }
        },
        {
          "@type": "Question",
          "name": "Who manages my global PPC campaigns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your account is managed by Google Ads & Meta Certified Performance Specialists supervised directly by Founder Gaurav Dubey."
          }
        },
        {
          "@type": "Question",
          "name": "Why choose King of Digital Marketing for International PPC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We bring 13+ years of agency experience delivering over 900+ successful campaigns across 15+ countries, backed by transparent monthly KPI reports and high ROAS campaign strategies."
          }
        }
      ]
    }
    </script>
