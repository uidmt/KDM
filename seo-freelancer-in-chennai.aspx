                 <script>
                    window.onload = () => {
                        // Ratings Counter (Decimal)
                        let ratingVal = 0;
                        const ratingTarget = 4.6;
                        const ratingEl = document.getElementById("rating");
                        const ratingInterval = setInterval(() => {
                            ratingVal += 0.1;
                            if (ratingVal >= ratingTarget) {
                                ratingVal = ratingTarget;
                                clearInterval(ratingInterval);
                            }
                            ratingEl.textContent = ratingVal.toFixed(1) + "+";
                        }, 50);

                        // Projects Counter (Whole number)
                        let projectVal = 0;
                        const projectTarget = 850;
                        const projectEl = document.getElementById("projectsCounter");
                        const projectInterval = setInterval(() => {
                            projectVal += 10; // adjust for speed
                            if (projectVal >= projectTarget) {
                                projectVal = projectTarget;
                                clearInterval(projectInterval);
                            }
                            projectEl.textContent = projectVal + "+";
                        }, 30);
                    };
                </script>
              
