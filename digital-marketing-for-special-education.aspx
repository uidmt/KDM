        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Hyper-local Google Search and Meta Ads generate direct parent assessment inquiries within 24 to 48 hours. Organic Google Maps 3-Pack and SEO establish a continuous stream of organic walk-ins and phone calls within 30 to 60 days."
