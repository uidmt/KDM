        {
          "@type": "Question",
          "name": "What is included in your YouTube Marketing Packages?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our YouTube marketing packages include channel audit & setup, Video SEO (titles, descriptions, tags), custom thumbnail design, end screen & info cards, competitor analysis, YouTube Ads setup, and monthly performance reports."
          }
        },
        {
          "@type": "Question",
          "name": "Do you help with both organic Video SEO and paid YouTube Ads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Our packages combine organic Video SEO for long-term subscriber growth with paid YouTube Video Ads (In-Stream, Bumper, Shorts) for immediate view traction and lead generation."
          }
        },
        {
          "@type": "Question",
          "name": "Is the YouTube ad spend budget included in the package cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The monthly package fee covers complete campaign management, Video SEO, custom thumbnail designs, script hook optimization, and daily bid management. Ad spend is paid directly to Google Ads from your account."
          }
        },
        {
          "@type": "Question",
          "name": "Do you design eye-catching custom YouTube thumbnails?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, 100%. Our in-house graphic design team creates high-contrast, scroll-stopping custom thumbnails designed to maximize your video Click-Through Rate (CTR)."
          }
        },
        {
          "@type": "Question",
          "name": "How fast will YouTube Video Ads start driving views and leads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "YouTube Video Ads go live within 24 to 48 hours of campaign setup and Google approval. Once active, you begin receiving targeted video views and customer traffic immediately."
          }
        },
        {
          "@type": "Question",
          "name": "Can you assist with video script structures and retention hooks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. Our video strategists provide guidance on video intro hooks, storytelling retention structures, and clear CTAs to keep viewers watching longer."
          }
        },
        {
          "@type": "Question",
          "name": "What types of YouTube Video Ads do you set up?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manage Skippable In-Stream Ads, Non-Skippable In-Stream Ads, Bumper Ads, Discovery/In-Feed Video Ads, and Shorts Ads depending on your package tier and goals."
          }
        },
        {
          "@type": "Question",
          "name": "How do custom video remarketing audiences work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We build custom audiences of people who have watched your YouTube videos or visited your website, showing them targeted follow-up video ads to convert warm leads into sales."
          }
        },
        {
          "@type": "Question",
          "name": "How do you measure and report YouTube campaign ROI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We track key video metrics including total views, watch time retention, subscriber growth, CTR, Cost Per View (CPV), and customer lead conversions in clear monthly reports."
          }
        },
        {
          "@type": "Question",
          "name": "Why choose King of Digital Marketing for YouTube Marketing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "With 13+ years of digital marketing experience, 900+ completed projects, leadership from Gaurav Dubey, and a dedicated team of 12 in-house video specialists, we deliver maximum channel growth starting at INR 19,999/Month."
          }
        }
      ]
    }
    </script>
