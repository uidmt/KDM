<!-- ===== SCRIPTS: TESTIMONIALS SLIDER, CATEGORIES TRACK & STAT COUNTERS ===== -->
<script>
(function() {
	// 1. Testimonial Carousel Auto Slider
	function initTestimonials() {
		var slides = document.querySelectorAll('.kdm-testimonial-card');
		var dots = document.querySelectorAll('#kdmTestimonialDots .dot');
		var prevBtn = document.getElementById('kdmTestimonialPrev');
		var nextBtn = document.getElementById('kdmTestimonialNext');
		var currentSlide = 0;
		var slideInterval = null;

		if (slides.length === 0) return;

		function showSlide(index) {
			slides.forEach(function(slide) { slide.classList.remove('active'); });
			dots.forEach(function(dot) { dot.classList.remove('active'); });
			
			currentSlide = (index + slides.length) % slides.length;
			slides[currentSlide].classList.add('active');
			if (dots[currentSlide]) dots[currentSlide].classList.add('active');
		}

		function nextSlide() {
			showSlide(currentSlide + 1);
		}

		function prevSlide() {
			showSlide(currentSlide - 1);
		}

		if (nextBtn) {
			nextBtn.addEventListener('click', function() {
				nextSlide();
				resetAutoSlide();
			});
		}

		if (prevBtn) {
			prevBtn.addEventListener('click', function() {
				prevSlide();
				resetAutoSlide();
			});
		}

		dots.forEach(function(dot, idx) {
			dot.addEventListener('click', function() {
				showSlide(idx);
				resetAutoSlide();
			});
		});

		function startAutoSlide() {
			slideInterval = setInterval(nextSlide, 6000);
		}

		function resetAutoSlide() {
			clearInterval(slideInterval);
			startAutoSlide();
		}

		startAutoSlide();
	}

	// 2. Animated Number Counters on Scroll
	function initCounters() {
		var credSection = document.querySelector('.kdm-credentials-white-section');
		if (!credSection) return;

		var observer = new IntersectionObserver(function(entries) {
			entries.forEach(function(entry) {
				if (entry.isIntersecting) {
					var counters = credSection.querySelectorAll('.kdm-cred-num, .counter-value');
					counters.forEach(function(counter) {
						if (counter.getAttribute('data-animated') === 'true') return;
						counter.setAttribute('data-animated', 'true');

						var target = parseFloat(counter.getAttribute('data-to'));
						var decimals = parseInt(counter.getAttribute('data-decimals') || '0', 10);
						var append = counter.getAttribute('data-append') || '';
						var duration = 1500;
						var startTime = null;

						function step(timestamp) {
							if (!startTime) startTime = timestamp;
							var progress = Math.min((timestamp - startTime) / duration, 1);
							var current = progress * target;
							counter.innerText = (decimals > 0 ? current.toFixed(decimals) : Math.floor(current)) + append;
							if (progress < 1) {
								window.requestAnimationFrame(step);
							} else {
								counter.innerText = (decimals > 0 ? target.toFixed(decimals) : target) + append;
							}
						}
						window.requestAnimationFrame(step);
					});
					observer.unobserve(credSection);
				}
			});
		}, { threshold: 0.2 });

		observer.observe(credSection);
	}

	// 3. Industry / Categories Slider Auto Loop
	function initIndustrySlider() {
		var track = document.querySelector('.industry-slider .industry-track');
		var cards = document.querySelectorAll('.industry-track .industry-card');
		if (!track || cards.length === 0) return;

		var gap = 24;
		var index = 0;
		var isTransitioning = false;
		var originalCards = Array.from(cards);

		// Clone cards for continuous infinite looping
		originalCards.forEach(function(card) {
			track.appendChild(card.cloneNode(true));
		});

		function getSlideWidth() {
			if (cards[0] && cards[0].offsetWidth > 0) {
				return cards[0].offsetWidth + gap;
			}
			return 320;
		}

		function slide() {
			if (isTransitioning) return;
			var slideWidth = getSlideWidth();
			index++;
			track.style.transition = 'transform 0.8s ease-in-out';
			track.style.transform = 'translateX(-' + (index * slideWidth) + 'px)';

			if (index >= originalCards.length) {
				isTransitioning = true;
				setTimeout(function() {
					track.style.transition = 'none';
					index = 0;
					track.style.transform = 'translateX(0)';
					setTimeout(function() {
						track.style.transition = 'transform 0.8s ease-in-out';
						isTransitioning = false;
					}, 50);
				}, 800);
			}
		}

		var interval = setInterval(slide, 3500);

		track.addEventListener('mouseenter', function() {
			clearInterval(interval);
		});

		track.addEventListener('mouseleave', function() {
			interval = setInterval(slide, 3500);
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', function() {
			initTestimonials();
			initCounters();
			initIndustrySlider();
		});
	} else {
		initTestimonials();
		initCounters();
		initIndustrySlider();
	}
})();
</script>
</asp:Content>
