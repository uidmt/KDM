        }
      },
      {
        "@type": "Question",
        "name": "How do you filter out fake or low-quality numbers in real estate lead campaigns?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We implement custom lead form pre-qualification questions (e.g. minimum budget selection, preferred BHK configuration, expected purchase timeline) and instant WhatsApp OTP verification to ensure your sales team calls only genuine buyers."
        }
      },
      {
        "@type": "Question",
        "name": "Can you target NRI buyers for luxury Indian real estate projects?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! We run targeted international Meta and Google ad campaigns reaching NRIs in the US, UK, UAE, Singapore, Canada, and Australia who are actively seeking luxury investment properties or retirement homes in India."
        }
      },
      {
        "@type": "Question",
        "name": "How quickly can a real estate developer start getting site visit leads?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Meta Lead Ads and Google PPC campaigns start generating qualified homebuyer leads within 24 to 48 hours of campaign activation."
        }
      },
      {
        "@type": "Question",
        "name": "Do you build high-converting landing pages for real estate projects?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! We design fast-loading project micro-sites featuring 3D floor plans, video walkthroughs, amenity highlights, location advantages, pricing charts, and instant brochure download lead forms."
        }
      },
      {
        "@type": "Question",
        "name": "How do you rank our real estate agency on Google Maps?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We optimize your Google Business Profile (GMB) with property categories, geo-tagged site photos, local real estate citations, primary location keywords, and automated review collection from happy homebuyers."
        }
      },
      {
        "@type": "Question",
        "name": "What is the average Cost Per Lead (CPL) for real estate campaigns?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cost per lead varies by location and property tier (affordable vs luxury). Average Meta lead CPL ranges between ₹150 to ₹450 for residential apartments, while luxury commercial and NRI lead CPL ranges from ₹600 to ₹1,200."
        }
      },
      {
        "@type": "Question",
        "name": "How do you increase actual on-site visits from digital leads?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We implement automated instant WhatsApp CRM sequences that send location pins, 3D site walkthrough videos, and exclusive site-visit cab booking offers to leads within seconds of form submission."
        }
      },
      {
        "@type": "Question",
        "name": "Do you provide video marketing for real estate projects?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! We produce high-definition drone videos, sample flat walkthrough Shorts/Reels, founder interviews, and customer testimonial clips that showcase lifestyle amenities and build immense buyer trust."
        }
      },
      {
        "@type": "Question",
        "name": "Can you track exact ROI and sale conversions from digital ad spend?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, we integrate Meta Pixel, Google Analytics 4 (GA4), WhatsApp conversion tracking, and CRM integrations to track exact cost per site visit, booking conversion rates, and total property sales revenue."
        }
      },
      {
        "@type": "Question",
        "name": "Do you support commercial real estate and plot development projects?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, we run specialized campaigns for commercial retail shops, office spaces, warehousing, industrial plots, and residential plotted developments."
